{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "accessibility-states.ts",
    "run-updater-accessibility.ts",
    "specs/**/*.ts",
    "updater-accessibility-states.ts",
    "updater-wdio.conf.ts",
    "wdio.conf.ts"
  ]
}
