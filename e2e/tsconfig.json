{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "types": ["node", "bun", "@wdio/globals/types", "@wdio/mocha-framework"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "accessibility-states.ts",
    "application-scenario-wdio.conf.ts",
    "product-journey-wdio.conf.ts",
    "run-updater-accessibility.ts",
    "specs/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "updater-accessibility-states.ts",
    "updater-scenario-wdio.conf.ts",
    "updater-wdio.conf.ts",
    "wdio.conf.ts"
  ]
}
