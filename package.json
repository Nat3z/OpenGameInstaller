{
  "name": "ogi-monorepo",
  "private": true,
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "release": "bun run --filter './packages/*' release",
    "dev": "bun run --filter 'opengameinstaller-gui' dev",
    "test:accessibility": "bun run --cwd e2e test:accessibility",
    "test:e2e:application": "bun run --cwd e2e test:application-scenario",
    "test:e2e:application:failure": "bun run --cwd e2e test:application-scenario:failure",
    "test:e2e:updater": "bun run --cwd e2e test:updater-scenario",
    "test:e2e:packaged-handoff": "bun run --cwd e2e test:packaged-handoff",
    "test:production-package-boundary": "bun run --cwd e2e test:production-package-boundary",
    "e2e:observer": "bun run --cwd e2e observer",
    "format": "biome check --write package.json packages application/src application/package.json updater web/src web/community web/scripts web/package.json test-addon --files-ignore-unknown=true",
    "lint": "biome check package.json packages application/src application/package.json updater web/src web/community web/scripts web/package.json test-addon --files-ignore-unknown=true",
    "typecheck": "bun run --filter './packages/*' build && bun run --filter '*' typecheck"
  },
  "workspaces": [
    "packages/*",
    "application",
    "e2e",
    "updater",
    "web",
    "test-addon"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "electron": "^43.1.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/minimatch": "5.1.2",
    "@types/node": "^22.15.0"
  },
  "trustedDependencies": [
    "electron",
    "node-datachannel",
    "sharp"
  ]
}
