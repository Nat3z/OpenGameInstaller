{
  "name": "ogi-kit",
  "module": "./build/main.mjs",
  "type": "module",
  "main": "./build/main.cjs",
  "version": "1.1.0",
  "bin": {
    "ogi": "./build/main.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "default": "./build/index.mjs",
        "types": "./build/index.d.mts"
      },
      "require": {
        "default": "./build/index.cjs",
        "types": "./build/index.d.cts"
      }
    }
  },
  "typings": "./build/index.d.mts",
  "files": [
    "build"
  ],
  "author": {
    "name": "Nat3z",
    "email": "me@nat3z.com",
    "url": "https://nat3z.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nat3z/OpenGameInstaller",
    "directory": "packages/ogi"
  },
  "dependencies": {
    "@effect/cli": "^0.77.2",
    "@effect/platform": "^0.97.3",
    "@effect/platform-node": "^0.108.4",
    "@ogi-sdk/addon-server": "^1.1.3",
    "@ogi-sdk/executor": "^1.5.0",
    "effect": "^3.22.0",
    "semver": "^7.7.3"
  },
  "scripts": {
    "auto-build": "tsc -w",
    "build": "bun run --cwd ../update-channel build && tsdown --config tsdown.config.js && bun run --filter '../../packages/addon-server' generate:event-proxy",
    "typecheck": "tsc --noEmit",
    "release": "bun run build && bun publish --access public",
    "dev": "bun run src/main.ts",
    "dev:link": "bun run --cwd ../executor build && bun run build && bun link && tsdown --config tsdown.config.js --watch",
    "format": "biome check --write src package.json --files-ignore-unknown=true",
    "lint": "biome check src package.json --files-ignore-unknown=true",
    "release-beta": "bun run build && bun publish --access public --tag future"
  },
  "devDependencies": {
    "@ogi/update-channel": "workspace:*",
    "@types/node": "^20.14.12",
    "tsdown": "^0.20.0-beta.4",
    "typescript": "^5.0.0"
  },
  "description": "CLI for developing and running OpenGameInstaller addons.",
  "license": "MIT"
}
